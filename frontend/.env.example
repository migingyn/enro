# Copy to frontend/.env.local to override. Vite reads VITE_* at dev/build time.
# true: every API call and websocket replays contracts/examples. false: talk to the backend.
VITE_USE_MOCKS=true
# Backend the dev server proxies /api, /oauth, /audio, /health and /ws to.
VITE_API_BASE=http://localhost:8080
