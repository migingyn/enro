{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enro.local/schemas/onboarding_complete.schema.json",
  "title": "POST /api/onboarding/complete",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user",
    "contacts",
    "oauth_url"
  ],
  "properties": {
    "user": {
      "$ref": "common.schema.json#/$defs/User"
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/EmergencyContact"
      }
    },
    "oauth_url": {
      "type": "string"
    }
  }
}
