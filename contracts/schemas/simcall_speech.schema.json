{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enro.local/schemas/simcall_speech.schema.json",
  "title": "WS /ws/sim-call browser->server: user said something",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "ts",
    "data"
  ],
  "properties": {
    "type": {
      "const": "speech"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "text"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
