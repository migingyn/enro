# Enro environment (PRD 12). Copy to .env and fill in only what your task needs:
#   cp .env.example .env
# Every provider defaults to fake, so an empty .env (or none at all) runs the whole demo with zero keys.
# Never commit .env. Real environment variables override values in this file.

# ---- server ----
PORT=8080
PUBLIC_BASE_URL=                # https://<your-ngrok-domain> when Twilio or Google must reach you (T02, T03)
FRONTEND_URL=http://localhost:5173
DB_PATH=./enro.db               # relative to the repo root; ":memory:" for a throwaway DB
DEMO_MODE=true                  # seed the demo user, calendar, and history on boot
LOG_LEVEL=info                  # debug | info | warn | error

# ---- providers (flip yours when your task is ready) ----
VOICE_PROVIDER=sim              # sim | twilio | retell        (T02)
LLM_PROVIDER=fake               # fake | openai | anthropic    (T01; voice always uses OpenAI)
REFLEX_PROVIDER=rules           # rules | jev                  (T14)
CALENDAR_SOURCE=seed            # seed | google                (T03)
EMAIL_SOURCE=seed               # seed | gmail                 (T03)
TRANSIT_SOURCE=replay           # replay | gtfs                (T15; the demo trip always replays)

# ---- OpenAI (T01, T12, T17) ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_TRANSCRIBE_MODEL=

# ---- Twilio (T02, T10) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=             # E.164, e.g. +18585550100

# RETELL ALTERNATE (commented out, PRD 11)
# RETELL_API_KEY=
# RETELL_AGENT_ID=

# CLAUDE API ALTERNATE (commented out, PRD 8.1)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ---- Jev reflex (T14) ----
TYPESAFE_API_KEY=
JEV_MODEL=
JEV_TIMEOUT_MS=400              # rules fallback after this
# OPENROUTER_API_KEY=           # alternate route to Jev

# ---- Google (T03) ----
# OAuth redirect URI to register: <PUBLIC_BASE_URL or http://localhost:8080>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=            # set = Routes API, empty = fixed speeds per mode

# ---- live transit (T15, P1) ----
GTFS_RT_VEHICLE_URL=
GTFS_RT_TRIP_UPDATES_URL=
POLL_SECONDS=60
