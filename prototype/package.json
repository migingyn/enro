{
  "name": "enro",
  "version": "1.0.0",
  "description": "Calls and departure reminders planned around your day",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:3333 --protocol http2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/migingyn/enro.git"
  },
  "keywords": [],
