  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/migingyn/enro/issues"
  },
  "homepage": "https://github.com/migingyn/enro#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ical.js": "^2.2.1",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
